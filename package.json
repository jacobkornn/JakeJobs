{
  "name": "jakejobs-system",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run build:electron && npm run dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build": "npm run build:electron && npm run build:vite",
    "start": "electron ."
  },
  "keywords": [],
  "author": "Jake Korn",
  "license": "ISC",
  "description": "JakeJobs System - Job prospecting pipeline with Dynamics 365, Careerflow, Wiza, and Claude",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@azure/msal-node": "^5.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "electron": "^41.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wait-on": "^9.0.4"
  }
}
